{
  "name": "numbies-xyz",
  "version": "1.2.42",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' one dev",
    "dev:clean": "one dev --clean",
    "ios": "./scripts/ios-dev.sh --no-server",
    "ios:server": "./scripts/ios-dev.sh",
    "ios:rebuild": "./scripts/ios-dev.sh --rebuild",
    "ios:device": "./scripts/ios-device.sh",
    "ios:device:rebuild": "./scripts/ios-device.sh --rebuild",
