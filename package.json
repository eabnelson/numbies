    "@react-navigation/native": "~7.1.19",
    "@tamagui/config": "^1.142.0",
    "@tamagui/image-next": "^1.142.0",
    "@tamagui/lucide-icons": "^1.142.0",
    "@vxrn/color-scheme": "1.2.42",
