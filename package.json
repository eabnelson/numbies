    "ios:device:release:rebuild": "./scripts/ios-device-release.sh --rebuild",
    "ios:testflight": "./scripts/build-testflight.sh",
    "update": "eas update --channel production",
    "android": "one run:android",
    "build": "one build && tsx scripts/inject-og-tags.ts",
    "serve": "one serve",
    "clean": "one clean",
    "prebuild": "one prebuild",
    "typecheck": "tsc --noEmit",
    "upgrade:tamagui": "$npm_execpath up '*tamagui*' '@tamagui/*'"
  },
  "dependencies": {
