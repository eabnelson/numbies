  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@react-native-community/cli": "^20.0.2",
    "@tamagui/vite-plugin": "^1.142.0",
    "@types/react": "^19.2.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.12"
