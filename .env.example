# Convex Database
EXPO_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Privy Authentication
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
WEB_PUBLIC_PRIVY_CLIENT_ID=your-web-client-id
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your-native-client-id

# Testnet Faucet (seeds new users with $50 AUSD)
# This should only be set in Convex environment variables, not locally
# TEMPO_TESTNET_FAUCET_PRIVATE_KEY=0x...

# Development (optional)
# Used for HMR when developing on a remote device via Tailscale/ngrok
# DEV_HMR_HOST is used by Vite for web dev server
# EXPO_PUBLIC_DEV_HMR_HOST is used by native app for QR codes and deep links
# DEV_HMR_HOST=your-dev-hostname.example.com
# EXPO_PUBLIC_DEV_HMR_HOST=your-dev-hostname.example.com
